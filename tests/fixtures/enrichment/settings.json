  "source_tests": [
    "the engine default applies with no arg, no env and no lane row",
    "a per-call arg outranks everything",
    "env wins over a stored budget",
    "an invalid env value warns and the store still gets its turn"
  ],
  "extraction": "Actual unchanged V1 exported pure resolvers through Bun; no persistence/provider operations",
  "cases": [
    {
      "name": "default",
      "lane": {},
      "per_call": {},
      "imported_overrides": {},
      "expected": {
        "pauseStyle": "16",
        "pauseTextMode": "none",
        "rewriteBudgetMs": 5000
      }
    },
    {
      "name": "lane",
      "lane": {
        "pauseStyle": "15",
        "pauseTextMode": "pause"
      },
      "per_call": {},
      "imported_overrides": {},
      "expected": {
        "pauseStyle": "15",
        "pauseTextMode": "pause",
        "rewriteBudgetMs": 5000
      }
    },
    {
      "name": "operator",
      "lane": {
        "pauseStyle": "15",
        "pauseTextMode": "pause"
      },
      "per_call": {},
      "imported_overrides": {
        "POLYGLOT_PAUSE_STYLE": "off",
        "POLYGLOT_PAUSE_TEXT_MODE": "word"
      },
      "expected": {
        "pauseStyle": "off",
        "pauseTextMode": "word",
        "rewriteBudgetMs": 5000
      }
    },
    {
      "name": "call",
      "lane": {
        "pauseStyle": "15",
        "pauseTextMode": "pause"
      },
      "per_call": {
        "pause_style": "16",
